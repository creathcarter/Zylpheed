; Script generated by the HM NIS Edit Script Wizard.
; Modified by Ikuya Awashiro <ikuya@fruitsbasket.info>
; Modified by Hiroyuki Yamamoto <hiro-y@kcn.ne.jp>
;
; 64-bit (GTK 3) version. Packages the self-contained folder made by
; nsis/make-dist-win64.sh. Normally built through nsis/make-installer-win64.sh,
; which also generates the uninstall file list; see nsis/README.txt.
;
; Defines (makensis -D...):
;   DIST_DIR          folder made by make-dist-win64.sh (default: Zylpheed)
;   UNINST_LIST       generated .nsh with the Delete/RMDir commands for the
;                     files of DIST_DIR (required)
;   OUTDIR            where to write the installer (default: this directory)
;   PRODUCT_VERSION   see zylpheed-defs.nsh
;   WITH_TEST_PLUGIN  also offer the "test" demo plug-in (off by default: it
;                     adds demo menus and redirects the update check URL)
;   HAVE_SYLFILTER, HAVE_BSFILTER, HAVE_AUTOENC_PLUGIN
;                     optional components from the official 32-bit installer;
;                     they need folders (sylfilter\, bsfilter\, autoenc\)
;                     that this build does not produce.
;   TARGET_X86        build with an x86 NSIS (official NSIS has no 64-bit
;                     stubs); the installer then still installs the 64-bit
;                     program into the 64-bit Program Files and registry view.
;
; No third-party NSIS plug-ins are needed. The old nsProcess check for a
; running sylpheed.exe is replaced by a check for Zylpheed's own single-instance
; mutex (System plug-in, part of NSIS).

Unicode true
!ifndef TARGET_X86
Target amd64-unicode
!endif

!include "zylpheed-defs.nsh"

!ifndef DIST_DIR
!define DIST_DIR "Zylpheed"
!endif
!ifndef UNINST_LIST
!error "UNINST_LIST is not defined; build with make-installer-win64.sh (see README.txt)"
!endif
!ifndef OUTDIR
!define OUTDIR "."
!endif

SetCompressor /SOLID lzma

!include "Memento.nsh"

; MUI 1.67 compatible ------
!include "MUI.nsh"
!include "Sections.nsh"
!include "LogicLib.nsh"
!include "FileFunc.nsh"
!include "x64.nsh"

; MUI Settings
!define MUI_ABORTWARNING
!define MUI_ICON "${NSISDIR}\Contrib\Graphics\Icons\modern-install-blue.ico"
!define MUI_UNICON "${NSISDIR}\Contrib\Graphics\Icons\modern-uninstall-blue.ico"

; Welcome page
!insertmacro MUI_PAGE_WELCOME
; License page
!define MUI_LICENSEPAGE_RADIOBUTTONS
!insertmacro MUI_PAGE_LICENSE $(license)
; Components page
!insertmacro MUI_PAGE_COMPONENTS
; Directory page
!insertmacro MUI_PAGE_DIRECTORY
; Instfiles page
!insertmacro MUI_PAGE_INSTFILES
; Finish page
;!define MUI_FINISHPAGE_RUN "$INSTDIR\zylpheed.exe"
;!define MUI_FINISHPAGE_RUN_NOTCHECKED
!define MUI_FINISHPAGE_SHOWREADME "$INSTDIR\doc\README.txt"
!define MUI_FINISHPAGE_SHOWREADME_NOTCHECKED
!define MUI_FINISHPAGE_SHOWREADME_FUNCTION "ShowReadme"
!define MUI_FINISHPAGE_SHOWREADME_TEXT "$(readme)"
!define MUI_FINISHPAGE_LINK "$(jump)"
!define MUI_FINISHPAGE_LINK_LOCATION ${PRODUCT_WEB_SITE}
!insertmacro MUI_PAGE_FINISH

; Uninstaller pages
!insertmacro MUI_UNPAGE_WELCOME
!define MUI_UNCONFIRMPAGE_TEXT_TOP "$(un_confirmpage_text_top)"
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_COMPONENTS
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH

; Language files
!insertmacro MUI_LANGUAGE "English" # ${LANG_ENGLISH}
!insertmacro MUI_LANGUAGE "Spanish" # ${LANG_SPANISH}
!insertmacro MUI_LANGUAGE "Japanese" # ${LANG_JAPANESE}

; Reserve files
!insertmacro MUI_RESERVEFILE_INSTALLOPTIONS

; MUI end ------

; The language files are not Unicode: spanish.nsh is ISO-8859-1 (CP1252),
; japanese.nsh is Shift_JIS (CP932).
!include "english.nsh"
!include /CHARSET=CP1252 "spanish.nsh"
!include /CHARSET=CP932 "japanese.nsh"

; Strings added for the 64-bit installer (English only for now).
LangString need_x64 ${LANG_ENGLISH} "This version of ${PRODUCT_NAME} requires 64-bit Windows."
LangString need_x64 ${LANG_SPANISH} "This version of ${PRODUCT_NAME} requires 64-bit Windows."
LangString need_x64 ${LANG_JAPANESE} "This version of ${PRODUCT_NAME} requires 64-bit Windows."

Var ISSILENT

;Name "${PRODUCT_NAME} ${PRODUCT_VERSION}"
;OutFile "${PRODUCT_NAME}-${PRODUCT_VERSION}_setup.exe"
Name "${INST_NAME} ${INST_VERSION}"
OutFile "${OUTDIR}\${INST_FILENAME}-${INST_VERSION}-x64_setup.exe"
InstallDir "$PROGRAMFILES64\${PRODUCT_NAME}"
; No InstallDirRegKey: it is read before .onInit can select the 64-bit
; registry view, and an x86 build would then find the 32-bit installation.
; .onInit reads the previous location itself.
RequestExecutionLevel admin
ShowInstDetails hide
ShowUnInstDetails hide
XPStyle on
BrandingText "${INST_NAME} ${INST_VERSION}"

; Returns in $R0 "1" if a Zylpheed with the default instance id is running
; (Zylpheed creates the named mutex "Zylpheed" in prohibit_duplicate_launch()
; in src/main.c), "0" otherwise. Instances started with --instance-id are not
; detected.
!macro CHECK_ZYLPHEED_RUNNING
  ; SYNCHRONIZE = 0x00100000
  System::Call 'kernel32::OpenMutexW(i 0x00100000, i 0, w "Zylpheed") p .r9'
  ${If} $9 P<> 0
    System::Call 'kernel32::CloseHandle(p r9)'
    StrCpy $R0 "1"
  ${Else}
    StrCpy $R0 "0"
  ${EndIf}
!macroend

${MementoSection} "!Zylpheed" sec_zylpheed
  SetShellVarContext all
  SectionIn RO
  SetOutPath "$INSTDIR"
  ; The whole self-contained folder, except plug-ins (own sections below)
  ; and the test launcher/profile that make-dist-win64.sh may have added.
  ; (/x matches names at any depth, so doc\plugins is skipped here too; the
  ; plug-in sections install their README.)
  File /r /x "run-test.bat" /x "zylpheed.ini" /x "profile" /x "profiles" /x "plugins" "${DIST_DIR}\*.*"
  CreateDirectory "$INSTDIR\plugins"
  CreateDirectory "$SMPROGRAMS\${PRODUCT_NAME}"

  ; The README-win32*.txt files of the official installer do not exist in
  ; this build; the source README is installed instead.
  CreateShortCut "$SMPROGRAMS\${PRODUCT_NAME}\README.lnk" "$INSTDIR\doc\README.txt"

  CreateShortCut "$SMPROGRAMS\${PRODUCT_NAME}\Zylpheed.lnk" "$INSTDIR\zylpheed.exe"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_NAME}\$(zylpheed_debug_mode_lnk).lnk" "$INSTDIR\zylpheed.exe" "--debug"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_NAME}\$(zylpheed_safe_mode_lnk).lnk" "$INSTDIR\zylpheed.exe" "--safe-mode"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_NAME}\$(zylpheed_all_quit_lnk).lnk" "$INSTDIR\zylpheed.exe" "--exit"
  WriteIniStr "$INSTDIR\${PRODUCT_NAME}.url" "InternetShortcut" "URL" "${PRODUCT_WEB_SITE}"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_NAME}\$(zylpheed_homepage_lnk).lnk" "$INSTDIR\${PRODUCT_NAME}.url"
  CreateShortCut "$SMPROGRAMS\${PRODUCT_NAME}\$(uninstall_lnk).lnk" "$INSTDIR\uninst.exe"
${MementoSectionEnd}

SectionGroup /e "$(plugins)" sec_plugins


${MementoSection} "$(attachment_tool_plugin)" sec_attachment_tool_plugin
  SetOutPath "$INSTDIR\plugins"
  File "${DIST_DIR}\plugins\attachment_tool.dll"
  SetOutPath "$INSTDIR\doc\plugins"
  File "${DIST_DIR}\doc\plugins\README.attachment_tool.txt"
${MementoSectionEnd}

!ifdef WITH_TEST_PLUGIN
${MementoUnselectedSection} "test" sec_test_plugin
  SetOutPath "$INSTDIR\plugins"
  File "${DIST_DIR}\plugins\test.dll"
  SetOutPath "$INSTDIR\doc\plugins"
  File "${DIST_DIR}\doc\plugins\README.test.txt"
${MementoSectionEnd}
!endif

!ifdef HAVE_AUTOENC_PLUGIN
${MementoSection} "$(autoenc_plugin)" sec_autoenc_plugin
  SetOutPath "$INSTDIR"
  File /r "autoenc\"
${MementoSectionEnd}
!endif

SectionGroupEnd

; sylfilter and bsfilter are separate programs that the official installer
; bundled. They are not part of this build.
!ifdef HAVE_SYLFILTER
${MementoSection} "sylfilter" sec_sylfilter
  SetOutPath "$INSTDIR"
  File /r "sylfilter\"
${MementoSectionEnd}
!endif

!ifdef HAVE_BSFILTER
${MementoSection} "bsfilter" sec_bsfilter
  SetOutPath "$INSTDIR"
  File /r "bsfilter\"
${MementoSectionEnd}
!endif

${MementoSection} "$(desktop_shortcut)" sec_desktop_shortcut
  SetShellVarContext current
  CreateShortCut "$DESKTOP\Zylpheed.lnk" "$INSTDIR\zylpheed.exe"
${MementoSectionEnd}

; The Quick Launch shortcut of the official installer is dropped: Windows 10
; and 11 have no Quick Launch bar.

${MementoSection} "$(handler)" sec_handler
   ; HKLM
   ; .eml
   WriteRegStr HKLM "Software\Classes\Zylpheed.EML" "" "Zylpheed Message"
   WriteRegDWORD HKLM "Software\Classes\Zylpheed.EML" "EditFlags" 0x00000002
   WriteRegStr HKLM "Software\Classes\Zylpheed.EML" "FriendlyTypeName" "Zylpheed Message"
   WriteRegStr HKLM "Software\Classes\Zylpheed.EML\DefaultIcon" "" "$INSTDIR\zylpheed.exe,0"
   WriteRegStr HKLM "Software\Classes\Zylpheed.EML\shell\open\command" "" "$\"$INSTDIR\zylpheed.exe$\" --open $\"%1$\""

   ; mailto:
   ; Only Zylpheed's own ProgID. The shared Software\Classes\mailto and
   ; .eml keys and the HKCU Software\Clients\Mail default are not written:
   ; they may belong to another mail client (for example an installed
   ; Sylpheed), and Zylpheed must not take them over.
   WriteRegStr HKLM "Software\Classes\Zylpheed.Url.MailTo" "" "URL:MailTo Protocol"
   WriteRegDWORD HKLM "Software\Classes\Zylpheed.Url.MailTo" "EditFlags" 0x00000002
   WriteRegStr HKLM "Software\Classes\Zylpheed.Url.MailTo" "FriendlyTypeName" "Zylpheed MailTo"
   WriteRegStr HKLM "Software\Classes\Zylpheed.Url.MailTo" "URL Protocol" ""
   WriteRegStr HKLM "Software\Classes\Zylpheed.Url.MailTo\DefaultIcon" "" "$INSTDIR\zylpheed.exe,0"
   WriteRegStr HKLM "Software\Classes\Zylpheed.Url.MailTo\shell\open\command" "" "$\"$INSTDIR\zylpheed.exe$\" --compose $\"%1$\""

   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed" "" "Zylpheed"
   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\DefaultIcon" "" "$INSTDIR\zylpheed.exe,0"
   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\Protocols\mailto" "" "URL:MailTo Protocol"
   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\Protocols\mailto" "URL Protocol" ""
   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\Protocols\mailto\DefaultIcon" "" "$INSTDIR\zylpheed.exe,0"
   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\Protocols\mailto\shell\open\command" "" "$\"$INSTDIR\zylpheed.exe$\" --compose $\"%1$\""
   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\shell\open\command" "" "$\"$INSTDIR\zylpheed.exe$\""

   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\Capabilities" "ApplicationName" "Zylpheed"
   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\Capabilities" "ApplicationIcon" "$INSTDIR\zylpheed.exe,0"
   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\Capabilities" "ApplicationDescription" "Zylpheed - lightweight and user-friendly e-mail client"
   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\Capabilities\FileAssociations" ".eml" "Zylpheed.EML"
   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\Capabilities\URLAssociations" "mailto" "Zylpheed.Url.MailTo"
   WriteRegStr HKLM "Software\Clients\Mail\Zylpheed\Capabilities\StartMenu" "Mail" "Zylpheed"

   WriteRegStr HKLM "Software\RegisteredApplications" "Zylpheed" "SOFTWARE\Clients\Mail\Zylpheed\Capabilities"

   ; HKCU

   ; The official installer also wrote the UserChoice keys for mailto: and
   ; .eml. Since Windows 8 those keys are protected by a hash that only
   ; Windows itself writes; a value written by an installer is ignored or
   ; triggers "An app default was reset". Zylpheed is registered above (and
   ; appears in Settings > Apps > Default apps); the user selects it there.

   ; .eml
   WriteRegStr HKCU "Software\Classes\Zylpheed.EML" "" "Zylpheed Message"
   WriteRegDWORD HKCU "Software\Classes\Zylpheed.EML" "EditFlags" 0x00000002
   WriteRegStr HKCU "Software\Classes\Zylpheed.EML" "FriendlyTypeName" "Zylpheed Message"
   WriteRegStr HKCU "Software\Classes\Zylpheed.EML\DefaultIcon" "" "$INSTDIR\zylpheed.exe,0"
   WriteRegStr HKCU "Software\Classes\Zylpheed.EML\shell\open\command" "" "$\"$INSTDIR\zylpheed.exe$\" --open $\"%1$\""

   ; mailto:
   WriteRegStr HKCU "Software\Classes\Zylpheed.Url.MailTo" "" "URL:MailTo Protocol"
   WriteRegDWORD HKCU "Software\Classes\Zylpheed.Url.MailTo" "EditFlags" 0x00000002
   WriteRegStr HKCU "Software\Classes\Zylpheed.Url.MailTo" "FriendlyTypeName" "Zylpheed MailTo"
   WriteRegStr HKCU "Software\Classes\Zylpheed.Url.MailTo" "URL Protocol" ""
   WriteRegStr HKCU "Software\Classes\Zylpheed.Url.MailTo\DefaultIcon" "" "$INSTDIR\zylpheed.exe,0"
   WriteRegStr HKCU "Software\Classes\Zylpheed.Url.MailTo\shell\open\command" "" "$\"$INSTDIR\zylpheed.exe$\" --compose $\"%1$\""

   ; tell Explorer that associations changed (SHCNE_ASSOCCHANGED)
   System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
${MementoSectionEnd}

${MementoSectionDone}

Section -Post
  WriteUninstaller "$INSTDIR\uninst.exe"
  WriteRegStr HKLM "${PRODUCT_DIR_REGKEY}" "" "$INSTDIR\zylpheed.exe"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayName" "$(^Name)"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "UninstallString" "$\"$INSTDIR\uninst.exe$\""
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayIcon" "$INSTDIR\zylpheed.exe"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "URLInfoAbout" "${PRODUCT_WEB_SITE}"
  WriteRegStr ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "Publisher" "${PRODUCT_PUBLISHER}"
  WriteRegDWORD ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "NoModify" 1
  WriteRegDWORD ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}" "NoRepair" 1
SectionEnd

Section "!un.Zylpheed" sec_un_zylpheed
  SetShellVarContext all
  Delete "$SMPROGRAMS\${PRODUCT_NAME}\README.lnk"
  Delete "$SMPROGRAMS\${PRODUCT_NAME}\Zylpheed.lnk"
  Delete "$SMPROGRAMS\${PRODUCT_NAME}\$(zylpheed_debug_mode_lnk).lnk"
  Delete "$SMPROGRAMS\${PRODUCT_NAME}\$(zylpheed_safe_mode_lnk).lnk"
  Delete "$SMPROGRAMS\${PRODUCT_NAME}\$(zylpheed_all_quit_lnk).lnk"
  Delete "$SMPROGRAMS\${PRODUCT_NAME}\$(zylpheed_homepage_lnk).lnk"
  Delete "$SMPROGRAMS\${PRODUCT_NAME}\$(uninstall_lnk).lnk"
  SetShellVarContext current

  ; Exactly the files that the main section installed (list generated from
  ; DIST_DIR at build time), then the directories that are empty afterwards.
  ; Nothing else in $INSTDIR is touched.
  !include "${UNINST_LIST}"

  Delete "$INSTDIR\${PRODUCT_NAME}.url"
  Delete "$INSTDIR\uninst.exe"
SectionEnd

SectionGroup /e "un.$(plugins)" sec_un_plugins


Section "un.$(attachment_tool_plugin)" sec_un_attachment_tool_plugin
  Delete "$INSTDIR\plugins\attachment_tool.dll"
SectionEnd

!ifdef WITH_TEST_PLUGIN
Section "un.test" sec_un_test_plugin
  Delete "$INSTDIR\plugins\test.dll"
SectionEnd
!endif

!ifdef HAVE_AUTOENC_PLUGIN
Section "un.$(autoenc_plugin)" sec_un_autoenc_plugin
  Delete "$INSTDIR\plugins\autoenc.dll"
  Delete "$INSTDIR\doc\autoenc\COPYING.txt"
  Delete "$INSTDIR\doc\autoenc\README.autoenc.txt"
  Delete "$INSTDIR\doc\autoenc\LICENSE.7-zip.txt"
  RMDir "$INSTDIR\doc\autoenc"
  Delete "$INSTDIR\7z.dll"
  Delete "$INSTDIR\7z.exe"
SectionEnd
!endif

SectionGroupEnd

!ifdef HAVE_SYLFILTER
Section "un.sylfilter" sec_un_sylfilter
  ; sylfilter components
  Delete "$INSTDIR\sylfilter.exe"
  Delete "$INSTDIR\sylfilter-cui.exe"
SectionEnd
!endif

!ifdef HAVE_BSFILTER
Section "un.bsfilter" sec_un_bsfilter
  ; bsfilter components
  Delete "$INSTDIR\bsfilter"
  Delete "$INSTDIR\bsfilterw.exe"
SectionEnd
!endif

Section "un.$(desktop_shortcut)" sec_un_desktop_shortcut
  SetShellVarContext current
  Delete "$DESKTOP\Zylpheed.lnk"
SectionEnd

Section "-un.install"
  SetShellVarContext all
  RMDir "$SMPROGRAMS\${PRODUCT_NAME}"
  SetShellVarContext current

  ; remove plug-ins dir only when empty
  RMDir "$INSTDIR\plugins"
  RMDir "$INSTDIR"

  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_UNINST_KEY}"
  DeleteRegKey ${PRODUCT_UNINST_ROOT_KEY} "${PRODUCT_DIR_REGKEY}"
  DeleteRegKey HKLM "Software\Classes\Zylpheed.EML"
  DeleteRegKey HKLM "Software\Classes\Zylpheed.Url.MailTo"
  DeleteRegKey HKLM "Software\Clients\Mail\Zylpheed"
  DeleteRegValue HKLM "Software\RegisteredApplications" "Zylpheed"
  DeleteRegKey HKCU "Software\Classes\Zylpheed.EML"
  DeleteRegKey HKCU "Software\Classes\Zylpheed.Url.MailTo"
  DeleteRegKey ${MEMENTO_REGISTRY_ROOT} "${MEMENTO_REGISTRY_KEY}"

  SetAutoClose true
SectionEnd

; Section descriptions
!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_zylpheed} "$(zylpheed_description)"
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_plugins} "$(plugins_description)"
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_attachment_tool_plugin} "$(attachment_tool_plugin_description)"
!ifdef HAVE_AUTOENC_PLUGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_autoenc_plugin} "$(autoenc_plugin_description)"
!endif
!ifdef HAVE_SYLFILTER
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_sylfilter} "$(sylfilter_description)"
!endif
!ifdef HAVE_BSFILTER
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_bsfilter} "$(bsfilter_description)"
!endif
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_desktop_shortcut} "$(desktop_shortcut_description)"
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_handler} "$(handler_description)"
!insertmacro MUI_FUNCTION_DESCRIPTION_END
!insertmacro MUI_UNFUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_un_zylpheed} "$(un_zylpheed_description)"
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_un_plugins} "$(un_plugins_description)"
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_un_attachment_tool_plugin} "$(un_attachment_tool_plugin_description)"
!ifdef HAVE_AUTOENC_PLUGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_un_autoenc_plugin} "$(un_autoenc_plugin_description)"
!endif
!ifdef HAVE_SYLFILTER
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_un_sylfilter} "$(un_sylfilter_description)"
!endif
!ifdef HAVE_BSFILTER
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_un_bsfilter} "$(un_bsfilter_description)"
!endif
  !insertmacro MUI_DESCRIPTION_TEXT ${sec_un_desktop_shortcut} "$(un_desktop_shortcut_description)"
  ; handler is not uninstallable.
!insertmacro MUI_UNFUNCTION_DESCRIPTION_END

Function .onInit
  ${IfNot} ${RunningX64}
    MessageBox MB_OK|MB_ICONSTOP "$(need_x64)"
    Abort
  ${EndIf}
  ; 64-bit program: 64-bit registry view for everything below (uninstall
  ; entry, App Paths, Memento, associations).
  SetRegView 64

  ; previous installation directory of this (64-bit) build
  ReadRegStr $R0 HKLM "${PRODUCT_DIR_REGKEY}" ""
  ${If} $R0 != ""
    ${GetParent} $R0 $R0
    StrCpy $INSTDIR $R0
  ${EndIf}

  ${MementoSectionRestore}

  StrCpy $1 ${sec_zylpheed}

; Prevent install while Zylpheed is running
check_app_running:
  !insertmacro CHECK_ZYLPHEED_RUNNING
  StrCmp $R0 "1" 0 +3
  MessageBox MB_OKCANCEL|MB_ICONEXCLAMATION "$(app_running)" IDOK check_app_running
  Abort

; An installed Sylpheed (official installer) is a different product with
; its own keys, files and profile; it is neither detected nor touched.

; Auto-uninstall old before installing new
; http://nsis.sourceforge.net/Auto-uninstall_old_before_installing_new
  ReadRegStr $R0 HKLM \
  "${PRODUCT_UNINST_KEY}" "UninstallString"
  StrCmp $R0 "" done_

  MessageBox MB_OKCANCEL|MB_ICONEXCLAMATION \
  "$(delete_caution)" \
  /SD IDOK \
  IDOK uninst
  Abort

;Run the uninstaller
uninst:
  ClearErrors
  StrCpy $ISSILENT "/S"
  IfSilent +2
    StrCpy $ISSILENT ""
  ExecWait '$R0 $ISSILENT _?=$INSTDIR' ;Do not copy the uninstaller to a temp file

  IfErrors no_remove_uninstaller done_
  no_remove_uninstaller:
  Abort

; label "done" used in MementoSectionRestore
done_:
FunctionEnd

Function .onInstSuccess
  ${MementoSectionSave}
FunctionEnd

Function .onSelChange
  !insertmacro StartRadioButtons $1
    !insertmacro RadioButton ${sec_zylpheed}
  !insertmacro EndRadioButtons
FunctionEnd

Function un.onInit
  SetRegView 64

check_app_running:
  ; Prevent uninstall while Zylpheed is running. (The official installer
  ; also killed sylpheed.exe and its helper programs with nsProcess;
  ; the user is asked to quit Zylpheed instead.)
  !insertmacro CHECK_ZYLPHEED_RUNNING
  StrCmp $R0 "1" 0 +3
  MessageBox MB_OKCANCEL|MB_ICONEXCLAMATION "$(app_running_uninst)" IDOK check_app_running
  Abort

  SetShellVarContext current

  IfFileExists "$INSTDIR\zylpheed.exe" sylpheed_file_exists
  !insertmacro UnselectSection ${sec_un_zylpheed}
  sylpheed_file_exists:
  !insertmacro SetSectionFlag ${sec_un_zylpheed} ${SF_RO}


  IfFileExists "$INSTDIR\plugins\attachment_tool.dll" attachment_tool_plugin_file_exists
  !insertmacro UnselectSection ${sec_un_attachment_tool_plugin}
  !insertmacro SetSectionFlag ${sec_un_attachment_tool_plugin} ${SF_RO}
  attachment_tool_plugin_file_exists:

!ifdef WITH_TEST_PLUGIN
  IfFileExists "$INSTDIR\plugins\test.dll" test_plugin_file_exists
  !insertmacro UnselectSection ${sec_un_test_plugin}
  !insertmacro SetSectionFlag ${sec_un_test_plugin} ${SF_RO}
  test_plugin_file_exists:
!endif

!ifdef HAVE_AUTOENC_PLUGIN
  IfFileExists "$INSTDIR\plugins\autoenc.dll" autoenc_plugin_file_exists
  !insertmacro UnselectSection ${sec_un_autoenc_plugin}
  !insertmacro SetSectionFlag ${sec_un_autoenc_plugin} ${SF_RO}
  autoenc_plugin_file_exists:
!endif

!ifdef HAVE_SYLFILTER
  IfFileExists "$INSTDIR\sylfilter.exe" sylfilter_file_exists
  !insertmacro UnselectSection ${sec_un_sylfilter}
  !insertmacro SetSectionFlag ${sec_un_sylfilter} ${SF_RO}
  sylfilter_file_exists:
!endif

!ifdef HAVE_BSFILTER
  IfFileExists "$INSTDIR\bsfilter" bsfilter_file_exists
  !insertmacro UnselectSection ${sec_un_bsfilter}
  !insertmacro SetSectionFlag ${sec_un_bsfilter} ${SF_RO}
  bsfilter_file_exists:
!endif

  SetShellVarContext current
  IfFileExists "$DESKTOP\Zylpheed.lnk" desktop_shortcut_file_exists
  !insertmacro UnselectSection ${sec_un_desktop_shortcut}
  !insertmacro SetSectionFlag ${sec_un_desktop_shortcut} ${SF_RO}
  desktop_shortcut_file_exists:
FunctionEnd

Function ShowReadme
  ExecShell open "$INSTDIR\doc\README.txt"
FunctionEnd
