1 VERSIONINFO
 FILEVERSION @MAJOR_VERSION@,@MINOR_VERSION@,@MICRO_VERSION@,@BUILD_REVISION@
 PRODUCTVERSION @MAJOR_VERSION@,@MINOR_VERSION@,@MICRO_VERSION@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x20L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hiroyuki Yamamoto; port by Creath and Claude\0"
            VALUE "Comments", "Forked from Sylpheed 3.8.0beta1 by Creath and Claude, 2026\0"
            VALUE "FileDescription", "Zylpheed\0"
            VALUE "FileVersion", "@MAJOR_VERSION@.@MINOR_VERSION@.@MICRO_VERSION@.@BUILD_REVISION@\0"
            VALUE "InternalName", "zylpheed\0"
            VALUE "LegalCopyright", "Copyright (C) 1999-2017 Hiroyuki Yamamoto\0"
            VALUE "OriginalFilename", "zylpheed.exe\0"
            VALUE "ProductName", "Zylpheed\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

ZYLPHEED ICON icons/zylpheed.ico

#include <winuser.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST zylpheed.exe.manifest
